# 매시 정각 빈 상태로 되돌린다 (경모님 2026-08-27: 시작점 = 완전 빈 DB).
# 최근 2시간 안에 화면에서 리셋·실행을 눌렀으면 건너뛴다 — QA 도중 되돌림 사고 방지.
[Unit]
Description=ENGRA hourly reset to empty state (skips if QA activity within 2h) — see tools/reset_if_idle.sh
After=engra.service

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/engra/tools/reset_if_idle.sh
